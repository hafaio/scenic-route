/public/dining/
/public/openstreets/
/public/landuse/
/public/industrial/
/public/historic/
# NOT public/sheds/ or public/ferry-schedule/: both are rebuilt daily by a job rather than by a
# deploy, so they are committed — the job reads the last one out of the checkout and the client reads
# it off `main` through raw.githubusercontent.com. Never LFS-track either (data/README.md).
# public/ferries/ above is a different thing entirely: the deploy's own drawn ferry lines.
# Nor public/icons/ or public/sw.js: hand-made static assets that no build step writes.

# raw source reads cached by `bun run build-tree-data`; --refresh to go back to the network
/.cache/

# build glue handed between the steps of `bun run build-tiles`, which package.json sequences and so
# can name no temporary directory of the machine's
/.build/

# rust build output; crates/tiler is compiled by `bun run build-tiles`
/target

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# firebase-admin service account key (used by scripts/set-admin.ts)
service-account.json

# firebase CLI config (kept local; not part of the repo)
.firebaserc
firebase.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# throwaway analysis harnesses (belong in the session scratchpad, never the repo)
/scratchpad/
